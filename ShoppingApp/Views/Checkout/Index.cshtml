@model ShoppingApp.Models.ViewModels.CheckoutViewModel

@{
    ViewBag.Title = "Checkout";
}

<h2>Checkout</h2>

@using (Html.BeginForm("PlaceOrder", "Checkout", new { area = "" }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Shipping Address</h3>
                </div>
                <div class="panel-body">
                    @if (Model.Addresses.Any())
                    {
                        @Html.ValidationMessageFor(m => m.SelectedAddressId, "", new { @class = "text-danger" })

                        foreach (var address in Model.Addresses)
                        {
                            <div class="radio">
                                <label>
                                    <input type="radio" name="SelectedAddressId" value="@address.AddressId" @(Model.SelectedAddressId == address.AddressId ? "checked" : "") />
                                    <strong>@address.AddressLabel</strong><br />
                                    @address.StreetAddress<br />
                                    @address.City, @address.PostalCode<br />
                                    @address.Country
                                </label>
                            </div>
                        }

                        <hr />
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <p>You don't have any saved addresses.</p>
                        </div>
                    }

                    @Html.ActionLink("Add New Address", "Create", "Addresses", new { returnUrl = Request.Url.PathAndQuery }, new { @class = "btn btn-default" })
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Discount Code</h3>
                </div>
                <div class="panel-body">
                    <span id="checkoutSubtotal" data-subtotal="@Model.Cart.Subtotal"></span>
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.DiscountCode, new { @class = "form-control", placeholder = "Enter discount code", id = "discountCodeInput" })
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-default" id="applyDiscountBtn">Apply</button>
                        </span>
                    </div>
                    <div id="discountMessage" class="help-block"></div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Order Items</h3>
                </div>
                <div class="panel-body">
                    <table class="table">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <tr>
                                <td>
                                    @item.ProductName <small class="text-muted">x @item.Quantity</small>
                                </td>
                                <td class="text-right">$@item.ItemTotal.ToString("F2")</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Order Summary</h3>
                </div>
                <div class="panel-body">
                    <p>Subtotal: <span class="pull-right" id="subtotal">$@Model.Cart.Subtotal.ToString("F2")</span></p>
                    <p>Discount: <span class="pull-right text-success" id="discountAmount">-$0.00</span></p>
                    <hr />
                    <h4>Total: <span class="pull-right" id="total">$@Model.Cart.Subtotal.ToString("F2")</span></h4>
                    <hr />
                    <button type="submit" class="btn btn-success btn-block btn-lg" @(Model.Addresses.Any() ? "" : "disabled")>
                        Place Order
                    </button>
                    <p class="text-center text-muted" style="margin-top: 10px;">
                        <small>By placing your order, you agree to our terms and conditions.</small>
                    </p>
                </div>
            </div>
        </div>
    </div>
}

