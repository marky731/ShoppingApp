@model ShoppingApp.Models.ViewModels.OrderConfirmationViewModel

@{
    ViewBag.Title = "Order Confirmation";
}

<div class="jumbotron text-center">
    <h1><span class="glyphicon glyphicon-ok-circle text-success"></span></h1>
    <h2>Thank You for Your Order!</h2>
    <p class="lead">@Model.Message</p>
    <p>Order #@Model.Order.OrderId</p>
</div>

<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Order Details</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Shipping Address</h4>
                        <address>
                            @Model.Order.ShippingAddress.AddressLabel<br />
                            @Model.Order.ShippingAddress.StreetAddress<br />
                            @Model.Order.ShippingAddress.City, @Model.Order.ShippingAddress.PostalCode<br />
                            @Model.Order.ShippingAddress.Country
                        </address>
                    </div>
                    <div class="col-md-6">
                        <h4>Order Summary</h4>
                        <p>Order Date: @Model.Order.OrderDate.ToString("MMMM dd, yyyy")</p>
                        <p>Subtotal: $@Model.Order.SubtotalAmount.ToString("F2")</p>
                        @if (Model.Order.DiscountId.HasValue)
                        {
                            <p>Discount: -$@((Model.Order.SubtotalAmount - Model.Order.TotalAmount).ToString("F2"))</p>
                        }
                        <p><strong>Total: $@Model.Order.TotalAmount.ToString("F2")</strong></p>
                    </div>
                </div>

                <hr />

                <h4>Items Ordered</h4>
                @foreach (var shopOrder in Model.Order.ShopOrders)
                {
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <strong>@shopOrder.Shop.ShopName</strong>
                            <span class="label label-info pull-right">@shopOrder.ShopOrderStatus</span>
                        </div>
                        <div class="panel-body">
                            <table class="table">
                                @foreach (var item in shopOrder.OrderItems)
                                {
                                    <tr>
                                        <td>@item.Product.ProductName x @item.Quantity</td>
                                        <td class="text-right">$@((item.PriceAtPurchase * item.Quantity).ToString("F2"))</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="text-center">
            @Html.ActionLink("View My Orders", "Index", "Orders", null, new { @class = "btn btn-primary" })
            @Html.ActionLink("Continue Shopping", "Index", "Products", null, new { @class = "btn btn-default" })
        </div>
    </div>
</div>
