@model ShoppingApp.Models.ViewModels.ProfileViewModel
@{
    ViewBag.Title = "My Profile";
}

<div class="container">
    <div class="row">
        <div class="col-md-3">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">Account</h4>
                </div>
                <div class="list-group">
                    <a href="@Url.Action("Index", "Profile")" class="list-group-item active">Profile</a>
                    <a href="@Url.Action("Edit", "Profile")" class="list-group-item">Edit Profile</a>
                    <a href="@Url.Action("ChangePassword", "Profile")" class="list-group-item">Change Password</a>
                    <a href="@Url.Action("Index", "Addresses")" class="list-group-item">Addresses</a>
                    <a href="@Url.Action("Index", "Orders")" class="list-group-item">Order History</a>
                    <a href="@Url.Action("Index", "Favorites")" class="list-group-item">Favorites</a>
                </div>
            </div>

            @if (User.IsInRole("seller"))
            {
                <div class="panel panel-info">
                    <div class="panel-heading">
                        <h4 class="panel-title">Seller</h4>
                    </div>
                    <div class="list-group">
                        <a href="@Url.Action("Index", "Dashboard", new { area = "Seller" })" class="list-group-item">
                            <span class="glyphicon glyphicon-dashboard"></span> Seller Dashboard
                        </a>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-9">
            <div class="page-header">
                <h2>My Profile</h2>
            </div>

            <div class="panel panel-default">
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="text-center">
                                <span class="glyphicon glyphicon-user" style="font-size: 100px; color: #ccc;"></span>
                                <h3>@Model.FirstName @Model.LastName</h3>
                                <p class="text-muted">@Model.Email</p>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <table class="table">
                                <tr>
                                    <th style="width: 150px;">First Name</th>
                                    <td>@Model.FirstName</td>
                                </tr>
                                <tr>
                                    <th>Last Name</th>
                                    <td>@Model.LastName</td>
                                </tr>
                                <tr>
                                    <th>Email</th>
                                    <td>@Model.Email</td>
                                </tr>
                                <tr>
                                    <th>Phone</th>
                                    <td>@(Model.Phone ?? "Not provided")</td>
                                </tr>
                                <tr>
                                    <th>Member Since</th>
                                    <td>@Model.CreatedAt.ToString("MMMM dd, yyyy")</td>
                                </tr>
                            </table>
                            <p>
                                @Html.ActionLink("Edit Profile", "Edit", null, new { @class = "btn btn-primary" })
                                @Html.ActionLink("Change Password", "ChangePassword", null, new { @class = "btn btn-default" })
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            @if (!User.IsInRole("seller") && !User.IsInRole("admin"))
            {
                <div class="panel panel-success">
                    <div class="panel-heading">
                        <h4 class="panel-title">Become a Seller</h4>
                    </div>
                    <div class="panel-body">
                        <p>Want to start selling on our platform? Create your shop and start earning today!</p>
                        <a href="@Url.Action("Create", "Shop", new { area = "Seller" })" class="btn btn-success">
                            <span class="glyphicon glyphicon-shop"></span> Create Your Shop
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
