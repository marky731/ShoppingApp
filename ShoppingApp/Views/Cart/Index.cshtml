@model ShoppingApp.Models.ViewModels.CartViewModel

@{
    ViewBag.Title = "Shopping Cart";
}

<div class="page-header">
    <h1>Shopping Cart</h1>
</div>

@if (Model.Items.Any())
{
    <div class="row">
        <div class="col-md-8">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th style="width: 150px;">Quantity</th>
                        <th>Total</th>
                        <th style="width: 50px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        <img src="@item.ProductImage" alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;">
                                    }
                                    <div>
                                        <strong>
                                            @Html.ActionLink(item.ProductName, "Details", "Products", new { id = item.ProductId }, null)
                                        </strong>
                                        <br />
                                        <small class="text-muted">@item.ShopName</small>
                                    </div>
                                </div>
                            </td>
                            <td>$@item.Price.ToString("F2")</td>
                            <td>
                                @using (Html.BeginForm("Update", "Cart", new { area = "" }, FormMethod.Post, new { @class = "form-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ProductId" value="@item.ProductId" />
                                    <div class="input-group input-group-sm">
                                        <input type="number" name="Quantity" value="@item.Quantity" min="1" max="@item.StockQuantity" class="form-control" style="width: 60px;">
                                        <span class="input-group-btn">
                                            <button type="submit" class="btn btn-default btn-sm">Update</button>
                                        </span>
                                    </div>
                                }
                            </td>
                            <td><strong>$@item.ItemTotal.ToString("F2")</strong></td>
                            <td>
                                @using (Html.BeginForm("Remove", "Cart", new { area = "" }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-link text-danger" style="padding: 4px 8px;">
                                        <span class="glyphicon glyphicon-trash"></span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @using (Html.BeginForm("Clear", "Cart", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to clear your cart?');">
                    <span class="glyphicon glyphicon-remove"></span> Clear Cart
                </button>
            }
        </div>

        <div class="col-md-4">
            <div class="summary-card">
                <h4>Order Summary</h4>
                <div class="summary-row">
                    <span>Items</span>
                    <span>@Model.TotalItems</span>
                </div>
                <div class="summary-divider"></div>
                <div class="summary-row summary-total">
                    <span>Subtotal</span>
                    <span>$@Model.Subtotal.ToString("F2")</span>
                </div>
                <a href="@Url.Action("Index", "Checkout")" class="btn btn-primary btn-block" style="margin-top: 20px;">
                    Proceed to Checkout
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <h4>Your cart is empty</h4>
        <p>Browse our products and add items to your cart.</p>
        <p>
            @Html.ActionLink("Continue Shopping", "Index", "Products", null, new { @class = "btn btn-primary" })
        </p>
    </div>
}
