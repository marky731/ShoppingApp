@model ShoppingApp.Models.ViewModels.ProductListViewModel

@{
    ViewBag.Title = "Products";
}

<h2>Products</h2>

<div class="row">
    <div class="col-md-3">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Filters</h3>
            </div>
            <div class="panel-body">
                @using (Html.BeginForm("Index", "Products", FormMethod.Get))
                {
                    <div class="form-group">
                        <label>Search</label>
                        <input type="text" name="SearchTerm" value="@Model.Filters.SearchTerm" class="form-control" placeholder="Search..." />
                    </div>

                    <div class="form-group">
                        <label>Category</label>
                        <select name="CategoryId" class="form-control">
                            <option value="">All Categories</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId" @(Model.Filters.CategoryId == category.CategoryId ? "selected" : "")>
                                    @category.CategoryName
                                </option>
                                foreach (var sub in category.SubCategories)
                                {
                                    <option value="@sub.CategoryId" @(Model.Filters.CategoryId == sub.CategoryId ? "selected" : "")>
                                        &nbsp;&nbsp;- @sub.CategoryName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Min Price</label>
                        <input type="number" name="MinPrice" value="@Model.Filters.MinPrice" class="form-control" placeholder="Min price" />
                    </div>

                    <div class="form-group">
                        <label>Max Price</label>
                        <input type="number" name="MaxPrice" value="@Model.Filters.MaxPrice" class="form-control" placeholder="Max price" />
                    </div>

                    <div class="form-group">
                        <label>Sort By</label>
                        <select name="SortBy" class="form-control">
                            <option value="newest" @(Model.Filters.SortBy == "newest" ? "selected" : "")>Newest</option>
                            <option value="price_low" @(Model.Filters.SortBy == "price_low" ? "selected" : "")>Price: Low to High</option>
                            <option value="price_high" @(Model.Filters.SortBy == "price_high" ? "selected" : "")>Price: High to Low</option>
                            <option value="rating" @(Model.Filters.SortBy == "rating" ? "selected" : "")>Top Rated</option>
                            <option value="popular" @(Model.Filters.SortBy == "popular" ? "selected" : "")>Most Popular</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">Apply Filters</button>
                    <a href="@Url.Action("Index", "Products")" class="btn btn-default btn-block">Clear Filters</a>
                }
            </div>
        </div>
    </div>

    <div class="col-md-9">
        @if (Model.Products.Any())
        {
            <p class="text-muted">Showing @Model.Products.FirstItemOnPage - @Model.Products.LastItemOnPage of @Model.Products.TotalItemCount products</p>

            <div class="row">
                @foreach (var product in Model.Products)
                {
                    @Html.Partial("_ProductCard", product)
                }
            </div>

            <div class="text-center">
                @Html.PagedListPager(Model.Products, page => Url.Action("Index", new {
                    Page = page,
                    SearchTerm = Model.Filters.SearchTerm,
                    CategoryId = Model.Filters.CategoryId,
                    MinPrice = Model.Filters.MinPrice,
                    MaxPrice = Model.Filters.MaxPrice,
                    Brand = Model.Filters.Brand,
                    SortBy = Model.Filters.SortBy
                }))
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <p>No products found matching your criteria.</p>
            </div>
        }
    </div>
</div>
