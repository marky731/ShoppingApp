@model ShoppingApp.Models.Domain.Product

<div class="product-card" data-href="@Url.Action("Details", "Products", new { id = Model.ProductId })">
    <div class="product-card-image">
        @if (!string.IsNullOrEmpty(Model.MainImageUrl))
        {
            <img src="@Model.MainImageUrl" alt="@Model.ProductName">
        }
        else
        {
            <img src="https://via.placeholder.com/300x300?text=No+Image" alt="@Model.ProductName">
        }
        @if (Request.IsAuthenticated)
        {
            <button type="button" class="product-card-favorite btn-add-favorite" data-product-id="@Model.ProductId" title="Add to favorites">
                <span class="heart-icon glyphicon glyphicon-heart-empty"></span>
            </button>
        }
    </div>
    <div class="product-card-body">
        <div class="product-card-title">
            @(Model.ProductName.Length > 40 ? Model.ProductName.Substring(0, 37) + "..." : Model.ProductName)
        </div>
        <div class="product-card-price">
            $@Model.Price.ToString("F2")
        </div>
        @if (Model.StockQuantity > 0)
        {
            <button type="button" class="btn-add-cart" data-product-id="@Model.ProductId">
                Add to Cart
            </button>
        }
        else
        {
            <button type="button" class="btn-add-cart" disabled style="background-color: var(--text-muted);">
                Out of Stock
            </button>
        }
    </div>
</div>
