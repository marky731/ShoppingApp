@using Microsoft.AspNet.Identity

@if (Request.IsAuthenticated)
{
    var userId = User.Identity.GetUserId();
    <li>
        <a href="@Url.Action("Index", "Cart", new { area = "" })">
            <span class="glyphicon glyphicon-shopping-cart"></span> Cart
            <span class="badge cart-count" style="display:none;"></span>
        </a>
    </li>
    <li>
        @Html.ActionLink("Favorites", "Index", "Favorites", new { area = "" }, null)
    </li>
    <li class="dropdown">
        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
            @User.Identity.Name <span class="caret"></span>
        </a>
        <ul class="dropdown-menu">
            <li>@Html.ActionLink("My Profile", "Index", "Profile", new { area = "" }, null)</li>
            <li>@Html.ActionLink("My Orders", "Index", "Orders", new { area = "" }, null)</li>
            <li>@Html.ActionLink("My Reviews", "Index", "Reviews", new { area = "" }, null)</li>
            <li>@Html.ActionLink("My Addresses", "Index", "Addresses", new { area = "" }, null)</li>
            <li role="separator" class="divider"></li>
            @if (User.IsInRole("seller"))
            {
                <li>@Html.ActionLink("Seller Dashboard", "Index", "Dashboard", new { area = "Seller" }, null)</li>
                <li role="separator" class="divider"></li>
            }
            else
            {
                <li>@Html.ActionLink("Become a Seller", "Create", "Shop", new { area = "Seller" }, null)</li>
                <li role="separator" class="divider"></li>
            }
            @if (User.IsInRole("admin"))
            {
                <li>@Html.ActionLink("Admin Dashboard", "Index", "Dashboard", new { area = "Admin" }, null)</li>
                <li role="separator" class="divider"></li>
            }
            <li>
                <form action="@Url.Action("Logout", "Account", new { area = "" })" method="post" id="logoutForm" class="navbar-right">
                    @Html.AntiForgeryToken()
                    <a href="javascript:document.getElementById('logoutForm').submit()">Log out</a>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li>@Html.ActionLink("Log in", "Login", "Account", new { area = "" }, null)</li>
    <li>@Html.ActionLink("Register", "Register", "Account", new { area = "" }, null)</li>
}
