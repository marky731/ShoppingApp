@using Microsoft.AspNet.Identity
@using ShoppingApp.Models.Identity

@if (Request.IsAuthenticated)
{
    var userId = User.Identity.GetUserId();
    string userEmail = User.Identity.Name;
    string userName = User.Identity.Name;
    string userRole = "Customer";

    using (var db = new ApplicationDbContext())
    {
        var user = db.Users.Find(userId);
        if (user != null)
        {
            userName = user.FullName ?? user.UserName;
            userEmail = user.Email;
        }
    }

    if (User.IsInRole("admin"))
    {
        userRole = "Admin";
    }
    else if (User.IsInRole("seller"))
    {
        userRole = "Seller";
    }

    // Admin Badge
    if (User.IsInRole("admin"))
    {
        <li class="nav-role-badge">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="role-link admin" title="Admin Dashboard">
                <span class="glyphicon glyphicon-cog"></span> Admin
            </a>
        </li>
    }
    else if (User.IsInRole("seller"))
    {
        <li class="nav-role-badge">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Seller" })" class="role-link seller" title="Seller Dashboard">
                <span class="glyphicon glyphicon-briefcase"></span> Seller
            </a>
        </li>
    }

    <!-- Favorites -->
    <li>
        <a href="@Url.Action("Index", "Favorites", new { area = "" })" title="Favorites">
            <span class="glyphicon glyphicon-heart"></span>
        </a>
    </li>

    <!-- Cart -->
    <li>
        <a href="@Url.Action("Index", "Cart", new { area = "" })" title="Shopping Cart">
            <span class="glyphicon glyphicon-shopping-cart"></span>
            <span class="icon-badge cart-count" style="display:none;"></span>
        </a>
    </li>

    <!-- Profile Dropdown -->
    <li class="dropdown profile-dropdown">
        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
            <span class="glyphicon glyphicon-user"></span>
        </a>
        <ul class="dropdown-menu dropdown-menu-right">
            <!-- Profile Header -->
            <li class="dropdown-header">
                <div class="profile-header">
                    <div class="profile-avatar">
                        <span class="glyphicon glyphicon-user"></span>
                    </div>
                    <div class="profile-info">
                        <h5>@userName</h5>
                        <p>@userEmail</p>
                        <span class="role-badge @userRole.ToLower()">@userRole</span>
                    </div>
                </div>
            </li>

            <!-- Menu Items -->
            <li class="profile-menu">
                <a href="@Url.Action("Index", "Orders", new { area = "" })">
                    <span class="menu-icon glyphicon glyphicon-list-alt"></span>
                    My Orders
                </a>
                <a href="@Url.Action("Index", "Favorites", new { area = "" })">
                    <span class="menu-icon glyphicon glyphicon-heart"></span>
                    My Favorites
                </a>
                <a href="@Url.Action("Index", "Cart", new { area = "" })">
                    <span class="menu-icon glyphicon glyphicon-shopping-cart"></span>
                    Shopping Cart
                </a>
                <a href="@Url.Action("Index", "Addresses", new { area = "" })">
                    <span class="menu-icon glyphicon glyphicon-map-marker"></span>
                    My Addresses
                </a>

                @if (User.IsInRole("seller"))
                {
                    <div class="divider"></div>
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Seller" })">
                        <span class="menu-icon glyphicon glyphicon-dashboard"></span>
                        Seller Dashboard
                    </a>
                }
                else
                {
                    <div class="divider"></div>
                    <a href="@Url.Action("Create", "Shop", new { area = "Seller" })">
                        <span class="menu-icon glyphicon glyphicon-plus"></span>
                        Become a Seller
                    </a>
                }

                @if (User.IsInRole("admin"))
                {
                    <div class="divider"></div>
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" style="color: var(--danger-red);">
                        <span class="menu-icon glyphicon glyphicon-cog"></span>
                        Admin Dashboard
                    </a>
                }
            </li>

            <!-- Logout -->
            <li class="profile-logout">
                <form action="@Url.Action("Logout", "Account", new { area = "" })" method="post" id="logoutForm">
                    @Html.AntiForgeryToken()
                    <button type="submit">
                        <span class="glyphicon glyphicon-log-out"></span>
                        Logout
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li>
        <a href="@Url.Action("Login", "Account", new { area = "" })" class="btn btn-link">Log in</a>
    </li>
    <li>
        <a href="@Url.Action("Register", "Account", new { area = "" })" class="btn btn-primary btn-sm">Register</a>
    </li>
}
