@model IEnumerable<ShoppingApp.Models.Domain.Address>
@{
    ViewBag.Title = "My Addresses";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="page-header">
                <h2>My Addresses</h2>
            </div>

            <div class="text-right" style="margin-bottom: 20px;">
                @Html.ActionLink("Add New Address", "Create", null, new { @class = "btn btn-primary" })
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <p>You haven't added any addresses yet.</p>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var address in Model)
                    {
                        <div class="col-md-6">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h4 class="panel-title">
                                        @address.AddressLabel
                                    </h4>
                                </div>
                                <div class="panel-body">
                                    <p>@address.StreetAddress</p>
                                    <p>@address.City, @address.PostalCode</p>
                                    <p>@address.Country</p>
                                </div>
                                <div class="panel-footer">
                                    @Html.ActionLink("Edit", "Edit", new { id = address.AddressId }, new { @class = "btn btn-sm btn-default" })

                                    using (Html.BeginForm("Delete", "Addresses", new { area = "", id = address.AddressId }, FormMethod.Post, new { style = "display:inline", onsubmit = "return confirm('Are you sure you want to delete this address?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
