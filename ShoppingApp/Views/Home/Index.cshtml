@model ShoppingApp.Models.ViewModels.HomeViewModel

@{
    ViewBag.Title = "Home";
}

<div class="jumbotron">
    <h1>Welcome to ShoppingApp</h1>
    <p class="lead">Your one-stop multi-vendor marketplace for all your shopping needs.</p>
    <p>
        @Html.ActionLink("Browse Products", "Index", "Products", null, new { @class = "btn btn-primary btn-lg" })
    </p>
</div>

<div class="row">
    <div class="col-md-12">
        <h2>Shop by Category</h2>
        <nav class="navbar navbar-default" style="margin-bottom: 20px;">
            <div class="container-fluid">
                <ul class="nav navbar-nav">
                    @foreach (var category in Model.Categories)
                    {
                        if (category.SubCategories.Any())
                        {
                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button">
                                    @category.CategoryName <span class="caret"></span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a href="@Url.Action("Index", "Products", new { CategoryId = category.CategoryId })">
                                            All @category.CategoryName
                                        </a>
                                    </li>
                                    <li class="divider"></li>
                                    @foreach (var sub in category.SubCategories)
                                    {
                                        <li>
                                            <a href="@Url.Action("Index", "Products", new { CategoryId = sub.CategoryId })">
                                                @sub.CategoryName
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="@Url.Action("Index", "Products", new { CategoryId = category.CategoryId })">
                                    @category.CategoryName
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h2>Featured Products</h2>
        <div class="row">
            @foreach (var product in Model.FeaturedProducts)
            {
                @Html.Partial("_ProductCard", product)
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h2>New Arrivals</h2>
        <div class="row">
            @foreach (var product in Model.NewArrivals)
            {
                @Html.Partial("_ProductCard", product)
            }
        </div>
    </div>
</div>
