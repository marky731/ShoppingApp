@model ShoppingApp.Models.ViewModels.HomeViewModel
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Home";
    var isAdmin = User.IsInRole("admin");
    var isSeller = User.IsInRole("seller");
    string userName = "";

    if (Request.IsAuthenticated)
    {
        userName = User.Identity.Name;
        using (var db = new ShoppingApp.Models.Identity.ApplicationDbContext())
        {
            var user = db.Users.Find(User.Identity.GetUserId());
            if (user != null && !string.IsNullOrEmpty(user.FullName))
            {
                userName = user.FullName.Split(' ')[0];
            }
        }
    }
}

<!-- Hero Section -->
<div class="hero-minimal">
    @if (Request.IsAuthenticated)
    {
        <h1 class="hero-animate">Welcome back, @userName!</h1>
        <p class="hero-animate hero-animate-delay">Discover amazing products from our curated collection.</p>
        <a href="@Url.Action("Index", "Products")" class="btn btn-primary btn-hero hero-animate hero-animate-delay-2">
            Shop Now
        </a>
    }
    else
    {
        <h1 class="hero-animate">Welcome to MINIMALSHOP</h1>
        <p class="hero-animate hero-animate-delay">Discover amazing products from our curated collection.</p>
        <a href="@Url.Action("Index", "Products")" class="btn btn-primary btn-hero hero-animate hero-animate-delay-2">
            Shop Now
        </a>
    }
</div>

<!-- Featured Products -->
<section style="margin-bottom: 48px;">
    <h2 style="margin-bottom: 24px;">Featured Products</h2>
    <div class="product-grid">
        @foreach (var product in Model.FeaturedProducts)
        {
            @Html.Partial("_ProductCard", product)
        }
    </div>
</section>

<!-- New Arrivals -->
<section style="margin-bottom: 48px;">
    <h2 style="margin-bottom: 24px;">New Arrivals</h2>
    <div class="product-grid">
        @foreach (var product in Model.NewArrivals)
        {
            @Html.Partial("_ProductCard", product)
        }
    </div>
</section>
