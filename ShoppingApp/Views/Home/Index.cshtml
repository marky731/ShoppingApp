@model ShoppingApp.Models.ViewModels.HomeViewModel
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Home";
    var isAdmin = User.IsInRole("admin");
    var isSeller = User.IsInRole("seller");
    string userName = "";

    if (Request.IsAuthenticated)
    {
        userName = User.Identity.Name;
        using (var db = new ShoppingApp.Models.Identity.ApplicationDbContext())
        {
            var user = db.Users.Find(User.Identity.GetUserId());
            if (user != null && !string.IsNullOrEmpty(user.FullName))
            {
                userName = user.FullName.Split(' ')[0];
            }
        }
    }
}

<!-- Hero Section -->
<div class="hero-minimal">
    @if (Request.IsAuthenticated)
    {
        <h1 class="hero-animate">Welcome back, @userName!</h1>
        <p class="hero-animate hero-animate-delay">Discover amazing products from our curated collection.</p>
        <a href="@Url.Action("Index", "Products")" class="btn btn-primary btn-hero hero-animate hero-animate-delay-2">
            Shop Now
        </a>
    }
    else
    {
        <h1 class="hero-animate">Welcome to MINIMALSHOP</h1>
        <p class="hero-animate hero-animate-delay">Discover amazing products from our curated collection.</p>
        <a href="@Url.Action("Index", "Products")" class="btn btn-primary btn-hero hero-animate hero-animate-delay-2">
            Shop Now
        </a>
    }
</div>

<!-- Category Navigation -->
<nav class="category-nav">
    <a href="@Url.Action("Index", "Products")" class="active">All Categories</a>
    @foreach (var category in Model.Categories)
    {
        if (category.SubCategories != null && category.SubCategories.Any())
        {
            <div class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                    @category.CategoryName <span class="caret"></span>
                </a>
                <ul class="dropdown-menu">
                    <li>
                        <a href="@Url.Action("Index", "Products", new { CategoryId = category.CategoryId })">
                            All @category.CategoryName
                        </a>
                    </li>
                    <li class="divider"></li>
                    @foreach (var sub in category.SubCategories)
                    {
                        <li>
                            <a href="@Url.Action("Index", "Products", new { CategoryId = sub.CategoryId })">
                                @sub.CategoryName
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <a href="@Url.Action("Index", "Products", new { CategoryId = category.CategoryId })">
                @category.CategoryName
            </a>
        }
    }
</nav>

<!-- Featured Products -->
<section style="margin-bottom: 48px;">
    <h2 style="margin-bottom: 24px;">Featured Products</h2>
    <div class="product-grid">
        @foreach (var product in Model.FeaturedProducts)
        {
            @Html.Partial("_ProductCard", product)
        }
    </div>
</section>

<!-- New Arrivals -->
<section style="margin-bottom: 48px;">
    <h2 style="margin-bottom: 24px;">New Arrivals</h2>
    <div class="product-grid">
        @foreach (var product in Model.NewArrivals)
        {
            @Html.Partial("_ProductCard", product)
        }
    </div>
</section>
