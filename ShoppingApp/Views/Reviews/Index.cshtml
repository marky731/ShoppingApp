@model IEnumerable<ShoppingApp.Models.ViewModels.CustomerReviewViewModel>
@using ShoppingApp.Models.Domain
@{
    ViewBag.Title = "My Reviews";
    var statusFilter = ViewBag.StatusFilter as ReviewStatus?;
}

<div class="page-header">
    <h1>My Reviews</h1>
</div>

<!-- Status Filter -->
<div class="panel panel-default">
    <div class="panel-body">
        <ul class="nav nav-pills">
            <li class="@(statusFilter == null ? "active" : "")">
                <a href="@Url.Action("Index")">All Reviews</a>
            </li>
            <li class="@(statusFilter == ReviewStatus.Pending ? "active" : "")">
                <a href="@Url.Action("Index", new { status = ReviewStatus.Pending })">
                    <span class="label label-warning">Pending</span>
                </a>
            </li>
            <li class="@(statusFilter == ReviewStatus.Approved ? "active" : "")">
                <a href="@Url.Action("Index", new { status = ReviewStatus.Approved })">
                    <span class="label label-success">Approved</span>
                </a>
            </li>
            <li class="@(statusFilter == ReviewStatus.Rejected ? "active" : "")">
                <a href="@Url.Action("Index", new { status = ReviewStatus.Rejected })">
                    <span class="label label-danger">Rejected</span>
                </a>
            </li>
        </ul>
    </div>
</div>

@if (Model.Any())
{
    foreach (var review in Model)
    {
        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="row">
                    <div class="col-xs-8">
                        <strong>
                            @Html.ActionLink(review.ProductName, "Details", "Products", new { id = review.ProductId }, null)
                        </strong>
                    </div>
                    <div class="col-xs-4 text-right">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="glyphicon glyphicon-star@(i <= review.Rating ? "" : "-empty")" style="color: gold;"></span>
                        }
                        @switch (review.Status)
                        {
                            case ReviewStatus.Pending:
                                <span class="label label-warning">Pending</span>
                                break;
                            case ReviewStatus.Approved:
                                <span class="label label-success">Approved</span>
                                break;
                            case ReviewStatus.Rejected:
                                <span class="label label-danger">Rejected</span>
                                break;
                        }
                    </div>
                </div>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-2 col-sm-3">
                        @if (!string.IsNullOrEmpty(review.ProductImageUrl))
                        {
                            <a href="@Url.Action("Details", "Products", new { id = review.ProductId })">
                                <img src="@review.ProductImageUrl" alt="@review.ProductName" class="img-responsive img-thumbnail" />
                            </a>
                        }
                    </div>
                    <div class="col-md-10 col-sm-9">
                        @if (!string.IsNullOrEmpty(review.Title))
                        {
                            <h4>@review.Title</h4>
                        }
                        <p>@review.Comment</p>
                        <p class="text-muted">
                            <small>
                                <span class="glyphicon glyphicon-time"></span>
                                Posted on @review.CreatedAt.ToString("MMMM dd, yyyy")
                            </small>
                        </p>

                        @if (review.Response != null)
                        {
                            <div class="well well-sm">
                                <strong><span class="glyphicon glyphicon-comment"></span> Seller Response:</strong>
                                <p>@review.Response.ResponseText</p>
                                <p class="text-muted"><small>Responded on @review.Response.CreatedAt.ToString("MMMM dd, yyyy")</small></p>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="panel-footer">
                @if (review.Status == ReviewStatus.Pending)
                {
                    @Html.ActionLink("Edit", "Edit", "Reviews", new { area = "", id = review.ReviewId }, new { @class = "btn btn-default btn-sm" })
                }
                @using (Html.BeginForm("Delete", "Reviews", new { area = "", id = review.ReviewId }, FormMethod.Post, new { style = "display:inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this review?');">
                        <span class="glyphicon glyphicon-trash"></span> Delete
                    </button>
                }
                @Html.ActionLink("View Product", "Details", "Products", new { id = review.ProductId }, new { @class = "btn btn-link btn-sm" })
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">
        <h4>No reviews found</h4>
        <p>You haven't written any reviews yet. Purchase and receive products to leave reviews!</p>
        <p>
            @Html.ActionLink("Browse Products", "Index", "Products", null, new { @class = "btn btn-primary" })
        </p>
    </div>
}
