@model PagedList.IPagedList<ShoppingApp.Models.ViewModels.AdminUserListItemViewModel>
@{
    ViewBag.Title = "Users";
}

<h1 class="page-header">Users</h1>

<!-- Filters -->
<div class="panel panel-default">
    <div class="panel-body">
        @using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "form-inline" }))
        {
            <div class="form-group">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or email..." />
            </div>
            <div class="form-group">
                @Html.DropDownList("role", new SelectList(new[] {
                    new { Value = "", Text = "All Roles" },
                    new { Value = "customer", Text = "Customer" },
                    new { Value = "seller", Text = "Seller" },
                    new { Value = "admin", Text = "Admin" }
                }, "Value", "Text", ViewBag.Role), new { @class = "form-control" })
            </div>
            <div class="form-group">
                @Html.DropDownList("status", new SelectList(new[] {
                    new { Value = "", Text = "All Status" },
                    new { Value = "active", Text = "Active" },
                    new { Value = "suspended", Text = "Suspended" }
                }, "Value", "Text", ViewBag.Status), new { @class = "form-control" })
            </div>
            <button type="submit" class="btn btn-default">Filter</button>
            <a href="@Url.Action("Index")" class="btn btn-link">Clear</a>
        }
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <strong>@user.FirstName @user.LastName</strong>
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                if (role == "admin")
                                {
                                    <span class="label label-danger">@role</span>
                                }
                                else if (role == "seller")
                                {
                                    <span class="label label-info">@role</span>
                                }
                                else
                                {
                                    <span class="label label-default">@role</span>
                                }
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="label label-success">Active</span>
                            }
                            else
                            {
                                <span class="label label-warning">Suspended</span>
                            }
                        </td>
                        <td>
                            @if (!user.Roles.Contains("admin"))
                            {
                                if (user.IsActive)
                                {
                                    using (Html.BeginForm("Suspend", "Users", new { area = "Admin", id = user.Id }, FormMethod.Post, new { style = "display:inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-xs btn-warning" onclick="return confirm('Are you sure you want to suspend this user?');">
                                            Suspend
                                        </button>
                                    }
                                }
                                else
                                {
                                    using (Html.BeginForm("Activate", "Users", new { area = "Admin", id = user.Id }, FormMethod.Post, new { style = "display:inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-xs btn-success">
                                            Activate
                                        </button>
                                    }
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="text-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, search = ViewBag.Search, role = ViewBag.Role, status = ViewBag.Status }))
    </div>
}
else
{
    <div class="alert alert-info">
        No users found matching your criteria.
    </div>
}
