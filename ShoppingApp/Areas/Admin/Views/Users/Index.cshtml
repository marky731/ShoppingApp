@model PagedList.IPagedList<ShoppingApp.Models.ViewModels.AdminUserListItemViewModel>
@{
    ViewBag.Title = "User Management";
}

<div class="page-header">
    <h1>User Management</h1>
    <div class="header-actions" style="display: flex; gap: 12px; align-items: center;">
        <div class="search-box" style="width: 200px;">
            <form action="@Url.Action("Index")" method="get">
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search users..." class="form-control" />
            </form>
        </div>
        <select name="role" onchange="window.location.href='@Url.Action("Index")?role=' + this.value" class="form-control" style="width: auto;">
            <option value="">All Roles</option>
            <option value="admin" @(ViewBag.Role == "admin" ? "selected" : "")>Admin</option>
            <option value="seller" @(ViewBag.Role == "seller" ? "selected" : "")>Seller</option>
            <option value="customer" @(ViewBag.Role == "customer" ? "selected" : "")>Customer</option>
        </select>
    </div>
</div>

@if (Model.Any())
{
    <table class="table table-modern">
        <thead>
            <tr>
                <th style="width: 60px;">ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Joined</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="text-muted">@user.Id.Substring(0, Math.Min(6, user.Id.Length))</td>
                    <td><strong>@user.FirstName @user.LastName</strong></td>
                    <td class="text-muted">@user.Email</td>
                    <td>
                        @foreach (var role in user.Roles)
                        {
                            if (role.ToLower() == "admin")
                            {
                                <span class="role-badge admin">Admin</span>
                            }
                            else if (role.ToLower() == "seller")
                            {
                                <span class="role-badge seller">Seller</span>
                            }
                            else
                            {
                                <span class="role-badge customer">Customer</span>
                            }
                        }
                    </td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="status-badge active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge inactive">Suspended</span>
                        }
                    </td>
                    <td class="text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="text-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, search = ViewBag.Search, role = ViewBag.Role, status = ViewBag.Status }))
    </div>
}
else
{
    <div class="alert alert-info">
        <h4>No users found</h4>
        <p>No users match your search criteria.</p>
    </div>
}
