@{
    var currentController = ViewContext.RouteData.Values["controller"].ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin Dashboard</title>
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/pagedlist")
</head>
<body class="dashboard-body">
    <div class="dashboard-container">
        <!-- Modern Sidebar -->
        <div class="modern-sidebar dashboard-sidebar">
            <div class="sidebar-header">
                <h4>Admin Dashboard</h4>
                <p class="subtitle">@User.Identity.Name</p>
            </div>

            <ul class="nav-sidebar">
                <li class="@(currentController == "Dashboard" ? "active" : "")">
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                        <span class="nav-icon glyphicon glyphicon-th-large"></span>
                        Overview
                    </a>
                </li>
                <li class="@(currentController == "Users" ? "active" : "")">
                    <a href="@Url.Action("Index", "Users", new { area = "Admin" })">
                        <span class="nav-icon glyphicon glyphicon-user"></span>
                        Users
                    </a>
                </li>
                <li class="@(currentController == "Sellers" ? "active" : "")">
                    <a href="@Url.Action("Pending", "Sellers", new { area = "Admin" })">
                        <span class="nav-icon glyphicon glyphicon-briefcase"></span>
                        Pending Sellers
                    </a>
                </li>
                <li class="@(currentController == "Categories" ? "active" : "")">
                    <a href="@Url.Action("Index", "Categories", new { area = "Admin" })">
                        <span class="nav-icon glyphicon glyphicon-tags"></span>
                        Categories
                    </a>
                </li>
                <li class="@(currentController == "Reviews" ? "active" : "")">
                    <a href="@Url.Action("Pending", "Reviews", new { area = "Admin" })">
                        <span class="nav-icon glyphicon glyphicon-comment"></span>
                        Reviews
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a href="@Url.Action("Index", "Home", new { area = "" })">
                    <span class="nav-icon glyphicon glyphicon-arrow-left"></span>
                    Back to Store
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="dashboard-main">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Error"]
                </div>
            }

            @RenderBody()
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/site")
    @RenderSection("scripts", required: false)
</body>
</html>
