@model IEnumerable<ShoppingApp.Models.ViewModels.CategoryListItemViewModel>
@{
    ViewBag.Title = "Categories";
}

<div class="page-header">
    <div class="pull-right">
        @Html.ActionLink("Add Category", "Create", null, new { @class = "btn btn-primary" })
    </div>
    <h1>Categories</h1>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Parent</th>
                    <th>Products</th>
                    <th>Order</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>
                            @if (category.ParentId.HasValue)
                            {
                                <span class="text-muted" style="margin-left: 20px;">|-- </span>
                            }
                            <strong>@category.Name</strong>
                            @if (!string.IsNullOrEmpty(category.Description))
                            {
                                <br />
                                <small class="text-muted">@category.Description</small>
                            }
                        </td>
                        <td>@(category.ParentName ?? "-")</td>
                        <td>@category.ProductCount</td>
                        <td>@category.DisplayOrder</td>
                        <td>
                            @if (category.IsActive)
                            {
                                <span class="label label-success">Active</span>
                            }
                            else
                            {
                                <span class="label label-default">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                @Html.ActionLink("Edit", "Edit", new { id = category.Id }, new { @class = "btn btn-default" })
                                @if (category.ProductCount == 0)
                                {
                                    <button type="button" class="btn btn-danger btn-delete" data-id="@category.Id" data-name="@category.Name">
                                        Delete
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <h4>No categories found</h4>
        <p>Create categories to organize products on your platform.</p>
        <p>
            @Html.ActionLink("Add Category", "Create", null, new { @class = "btn btn-primary" })
        </p>
    </div>
}

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Delete Category</h4>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="categoryName"></strong>?</p>
                <p class="text-danger">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                @using (Html.BeginForm("Delete", "Categories", FormMethod.Post, new { id = "deleteForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteCategoryId" />
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('.btn-delete').click(function () {
                var id = $(this).data('id');
                var name = $(this).data('name');
                $('#deleteCategoryId').val(id);
                $('#categoryName').text(name);
                $('#deleteModal').modal('show');
            });
        });
    </script>
}
