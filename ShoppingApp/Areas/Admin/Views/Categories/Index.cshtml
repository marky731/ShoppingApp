@model IEnumerable<ShoppingApp.Models.ViewModels.CategoryListItemViewModel>
@{
    ViewBag.Title = "Categories";
}

<div class="page-header-modern">
    <h1>Categories</h1>
    <a href="@Url.Action("Create")" class="btn-modern btn-modern-primary">
        <span class="glyphicon glyphicon-plus" style="margin-right: 8px;"></span>
        Add Category
    </a>
</div>

@if (Model.Any())
{
    <table class="table table-modern">
        <thead>
            <tr>
                <th>Name</th>
                <th>Parent</th>
                <th>Products</th>
                <th>Order</th>
                <th>Status</th>
                <th style="width: 140px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>
                        @if (category.ParentId.HasValue)
                        {
                            <span style="color: var(--text-muted); margin-left: 20px;">|-- </span>
                        }
                        <strong style="color: var(--text-primary);">@category.Name</strong>
                        @if (!string.IsNullOrEmpty(category.Description))
                        {
                            <br />
                            <small style="color: var(--text-muted);">@category.Description</small>
                        }
                    </td>
                    <td style="color: var(--text-secondary);">@(category.ParentName ?? "-")</td>
                    <td style="color: var(--text-secondary);">@category.ProductCount</td>
                    <td style="color: var(--text-muted);">@category.DisplayOrder</td>
                    <td>
                        @if (category.IsActive)
                        {
                            <span class="badge-modern badge-active">Active</span>
                        }
                        else
                        {
                            <span class="badge-modern badge-inactive">Inactive</span>
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = category.Id })" class="btn btn-default btn-xs" style="border-radius: 6px;">Edit</a>
                        @{
                            // Subcategories (have ParentId): can delete if no products
                            // Main categories (no ParentId): can delete if no products AND no subcategories
                            bool canDelete = category.ParentId.HasValue
                                ? category.ProductCount == 0
                                : (category.ProductCount == 0 && category.SubCategoryCount == 0);
                        }
                        @if (canDelete)
                        {
                            <button type="button" class="btn btn-danger btn-xs btn-delete" style="border-radius: 6px;" data-id="@category.Id" data-name="@category.Name">
                                Delete
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div style="text-align: center; padding: 60px 20px;">
        <p style="color: var(--text-muted); font-size: 16px; margin-bottom: 24px;">No categories found. Create categories to organize products.</p>
        <a href="@Url.Action("Create")" class="btn-modern btn-modern-primary">
            <span class="glyphicon glyphicon-plus" style="margin-right: 8px;"></span>
            Add Category
        </a>
    </div>
}

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Delete Category</h4>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="categoryName"></strong>?</p>
                <p class="text-danger">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                @using (Html.BeginForm("Delete", "Categories", new { area = "Admin" }, FormMethod.Post, new { id = "deleteForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteCategoryId" />
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('.btn-delete').click(function () {
                var id = $(this).data('id');
                var name = $(this).data('name');
                $('#deleteCategoryId').val(id);
                $('#categoryName').text(name);
                $('#deleteModal').modal('show');
            });
        });
    </script>
}
