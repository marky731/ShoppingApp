@model ShoppingApp.Models.ViewModels.SellerReviewDetailsViewModel
@{
    ViewBag.Title = "Review Details";
    Layout = "~/Areas/Seller/Views/Shared/_SellerLayout.cshtml";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h1>Review Details</h1>
    <a href="@Url.Action("Index", new { area = "Seller" })" class="btn btn-default">
        <span class="glyphicon glyphicon-arrow-left"></span> Back to Reviews
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["Error"]
    </div>
}

<div class="row">
    <div class="col-md-8">
        <!-- Review Card -->
        <div class="review-detail-card">
            <div class="review-detail-header">
                <div class="reviewer-info">
                    <div class="reviewer-avatar">
                        <span class="glyphicon glyphicon-user"></span>
                    </div>
                    <div class="reviewer-meta">
                        <h4>@Model.Customer.FirstName @Model.Customer.LastName</h4>
                        <span class="review-date">@Model.Review.CreatedAt.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>
                <div class="review-rating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="glyphicon glyphicon-star@(i <= Model.Review.Rating ? "" : "-empty")"></span>
                    }
                </div>
            </div>

            <div class="review-detail-body">
                @if (!string.IsNullOrEmpty(Model.Review.Title))
                {
                    <h3 class="review-title">@Model.Review.Title</h3>
                }
                <p class="review-comment">@Model.Review.Comment</p>
            </div>
        </div>

        <!-- Response Section -->
        <div class="response-section">
            <h3 class="section-title">
                <span class="glyphicon glyphicon-comment"></span> Your Response
            </h3>

            @if (Model.Response != null)
            {
                <div class="existing-response">
                    <div class="response-content">
                        <p>@Model.Response.ResponseText</p>
                        <span class="response-date">Responded on @Model.Response.CreatedAt.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>

                <div class="response-actions">
                    <h4>Update Response</h4>
                    @using (Html.BeginForm("Respond", "Reviews", new { area = "Seller", id = Model.Review.ReviewId }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <textarea name="responseText" class="form-control" rows="3" placeholder="Update your response...">@Model.Response.ResponseText</textarea>
                        </div>
                        <div class="btn-group-response">
                            <button type="submit" class="btn btn-primary">
                                <span class="glyphicon glyphicon-edit"></span> Update Response
                            </button>
                            @using (Html.BeginForm("DeleteResponse", "Reviews", new { area = "Seller", id = Model.Response.ResponseId }, FormMethod.Post, new { style = "display: inline;" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this response?');">
                                    <span class="glyphicon glyphicon-trash"></span> Delete
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-response">
                    <p class="help-text">Responding to reviews helps build trust with customers and shows that you value their feedback.</p>
                    @using (Html.BeginForm("Respond", "Reviews", new { area = "Seller", id = Model.Review.ReviewId }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <textarea name="responseText" class="form-control" rows="4" placeholder="Thank the customer or address their concerns..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <span class="glyphicon glyphicon-send"></span> Submit Response
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-md-4">
        <!-- Product Card -->
        <div class="sidebar-card">
            <h4 class="sidebar-card-title">Product</h4>
            <div class="product-preview">
                @if (!string.IsNullOrEmpty(Model.Product.MainImageUrl))
                {
                    <img src="@Model.Product.MainImageUrl" alt="@Model.Product.ProductName" class="product-preview-image" />
                }
                <div class="product-preview-info">
                    <h5>@Model.Product.ProductName</h5>
                    <p class="product-price">$@Model.Product.Price.ToString("F2")</p>
                    <div class="product-rating-small">
                        <span class="glyphicon glyphicon-star"></span>
                        @Model.Product.AverageRating.ToString("F1")
                        <span class="text-muted">(@Model.Product.TotalReviews reviews)</span>
                    </div>
                </div>
            </div>
            <a href="@Url.Action("Details", "Products", new { area = "Seller", id = Model.Product.ProductId })" class="btn btn-default btn-block" style="margin-top: 16px;">
                View Product
            </a>
        </div>

        <!-- Customer Info -->
        <div class="sidebar-card">
            <h4 class="sidebar-card-title">Customer Info</h4>
            <div class="customer-info">
                <div class="info-row">
                    <span class="glyphicon glyphicon-user"></span>
                    <span>@Model.Customer.FirstName @Model.Customer.LastName</span>
                </div>
                <div class="info-row">
                    <span class="glyphicon glyphicon-envelope"></span>
                    <span>@Model.Customer.Email</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .review-detail-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 24px;
    }

    .review-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
        background: #f9fafb;
    }

    .reviewer-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .reviewer-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: #6b7280;
    }

    .reviewer-meta h4 {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
    }

    .review-date {
        font-size: 13px;
        color: #6b7280;
    }

    .review-rating .glyphicon {
        color: #fbbf24;
        font-size: 18px;
    }

    .review-detail-body {
        padding: 24px;
    }

    .review-title {
        font-size: 20px;
        font-weight: 600;
        margin: 0 0 12px;
    }

    .review-comment {
        font-size: 16px;
        line-height: 1.7;
        color: #374151;
        margin: 0;
    }

    .response-section {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 24px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 600;
        margin: 0 0 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title .glyphicon {
        color: #6b7280;
    }

    .existing-response {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 20px;
    }

    .response-content p {
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 8px;
        color: #166534;
    }

    .response-date {
        font-size: 12px;
        color: #16a34a;
    }

    .response-actions h4 {
        font-size: 14px;
        font-weight: 600;
        margin: 0 0 12px;
        color: #6b7280;
    }

    .btn-group-response {
        display: flex;
        gap: 12px;
    }

    .no-response .help-text {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 16px;
        padding: 12px 16px;
        background: #f3f4f6;
        border-radius: 8px;
    }

    .sidebar-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .sidebar-card-title {
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #6b7280;
        margin: 0 0 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e5e7eb;
    }

    .product-preview {
        display: flex;
        gap: 16px;
    }

    .product-preview-image {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
    }

    .product-preview-info h5 {
        margin: 0 0 6px;
        font-size: 15px;
        font-weight: 600;
    }

    .product-price {
        font-size: 18px;
        font-weight: 700;
        color: #059669;
        margin: 0 0 6px;
    }

    .product-rating-small {
        font-size: 13px;
        color: #6b7280;
    }

    .product-rating-small .glyphicon {
        color: #fbbf24;
    }

    .customer-info .info-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .customer-info .info-row:last-child {
        border-bottom: none;
    }

    .customer-info .glyphicon {
        color: #9ca3af;
        width: 20px;
    }

    .btn-outline-danger {
        background: transparent;
        border: 1px solid #ef4444;
        color: #ef4444;
    }

    .btn-outline-danger:hover {
        background: #ef4444;
        color: white;
    }
</style>
