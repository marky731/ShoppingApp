@using Microsoft.AspNet.Identity
@using ShoppingApp.Models.Identity
@{
    var userId = User.Identity.GetUserId();
    string shopSlug = null;
    string shopName = "Seller Dashboard";
    if (!string.IsNullOrEmpty(userId))
    {
        using (var db = new ApplicationDbContext())
        {
            var shop = db.Shops.FirstOrDefault(s => s.SellerId == userId);
            if (shop != null)
            {
                shopSlug = shop.ShopId.ToString();
                shopName = shop.ShopName ?? "Seller Dashboard";
            }
        }
    }
    var currentController = ViewContext.RouteData.Values["controller"].ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Seller Dashboard</title>
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/pagedlist")
</head>
<body class="dashboard-body">
    <div class="dashboard-container">
        <!-- Modern Sidebar -->
        <div class="modern-sidebar dashboard-sidebar">
            <div class="sidebar-header">
                <h4>Seller Dashboard</h4>
                <p class="subtitle">@shopName</p>
            </div>

            <ul class="nav-sidebar">
                <li class="@(currentController == "Dashboard" ? "active" : "")">
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Seller" })">
                        <span class="nav-icon glyphicon glyphicon-th-large"></span>
                        Overview
                    </a>
                </li>
                <li class="@(currentController == "Products" ? "active" : "")">
                    <a href="@Url.Action("Index", "Products", new { area = "Seller" })">
                        <span class="nav-icon glyphicon glyphicon-shopping-cart"></span>
                        Products
                    </a>
                </li>
                <li class="@(currentController == "Orders" ? "active" : "")">
                    <a href="@Url.Action("Index", "Orders", new { area = "Seller" })">
                        <span class="nav-icon glyphicon glyphicon-list-alt"></span>
                        Orders
                    </a>
                </li>
                <li class="@(currentController == "Discounts" ? "active" : "")">
                    <a href="@Url.Action("Index", "Discounts", new { area = "Seller" })">
                        <span class="nav-icon glyphicon glyphicon-tag"></span>
                        Discounts
                    </a>
                </li>
                <li class="@(currentController == "Reviews" ? "active" : "")">
                    <a href="@Url.Action("Index", "Reviews", new { area = "Seller" })">
                        <span class="nav-icon glyphicon glyphicon-star"></span>
                        Reviews
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a href="@Url.Action("Index", "Home", new { area = "" })">
                    <span class="nav-icon glyphicon glyphicon-arrow-left"></span>
                    Back to Store
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="dashboard-main">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Error"]
                </div>
            }

            @RenderBody()
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/site")
    @RenderSection("scripts", required: false)
</body>
</html>
