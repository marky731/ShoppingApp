@model PagedList.IPagedList<ShoppingApp.Models.ViewModels.SellerProductListItemViewModel>
@{
    ViewBag.Title = "Products";
}

<div class="page-header">
    <div class="pull-right">
        @Html.ActionLink("Add New Product", "Create", null, new { @class = "btn btn-primary" })
    </div>
    <h1>Products</h1>
</div>

<!-- Filters -->
<div class="panel panel-default">
    <div class="panel-body">
        @using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "form-inline" }))
        {
            <div class="form-group">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search products..." />
            </div>
            <div class="form-group">
                @Html.DropDownList("categoryId", (SelectList)ViewBag.Categories, "All Categories", new { @class = "form-control" })
            </div>
            <div class="form-group">
                @Html.DropDownList("status", new SelectList(new[] {
                    new { Value = "", Text = "All Status" },
                    new { Value = "active", Text = "Active" },
                    new { Value = "inactive", Text = "Inactive" },
                    new { Value = "lowstock", Text = "Low Stock" }
                }, "Value", "Text", ViewBag.Status), new { @class = "form-control" })
            </div>
            <button type="submit" class="btn btn-default">Filter</button>
            <a href="@Url.Action("Index")" class="btn btn-link">Clear</a>
        }
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th style="width: 60px;"></th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Sales</th>
                    <th>Status</th>
                    <th style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr class="clickable" data-href="@Url.Action("Edit", new { id = product.Id })">
                        <td>
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" style="width: 50px; height: 50px; object-fit: cover;" class="img-thumbnail" />
                            }
                            else
                            {
                                <div style="width: 50px; height: 50px; background: #f5f5f5;" class="img-thumbnail"></div>
                            }
                        </td>
                        <td>
                            <strong>@product.Name</strong>
                            <br />
                            <small class="text-muted">SKU: @product.Sku</small>
                        </td>
                        <td>@product.CategoryName</td>
                        <td>
                            @if (product.DiscountedPrice.HasValue && product.DiscountedPrice < product.Price)
                            {
                                <span class="text-muted" style="text-decoration: line-through;">$@product.Price.ToString("N2")</span>
                                <br />
                                <strong class="text-success">$@product.DiscountedPrice.Value.ToString("N2")</strong>
                            }
                            else
                            {
                                <strong>$@product.Price.ToString("N2")</strong>
                            }
                        </td>
                        <td>
                            @if (product.Stock <= 0)
                            {
                                <span class="label label-danger">Out of Stock</span>
                            }
                            else if (product.Stock <= 10)
                            {
                                <span class="label label-warning">@product.Stock</span>
                            }
                            else
                            {
                                <span>@product.Stock</span>
                            }
                        </td>
                        <td>@product.TotalSales</td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="label label-success">Active</span>
                            }
                            else
                            {
                                <span class="label label-default">Inactive</span>
                            }
                        </td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm btn-delete" data-id="@product.Id" data-name="@product.Name">
                                <span class="glyphicon glyphicon-trash"></span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="text-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, search = ViewBag.Search, categoryId = ViewBag.CategoryId, status = ViewBag.Status }))
    </div>
}
else
{
    <div class="alert alert-info">
        <h4>No products found</h4>
        <p>Get started by adding your first product.</p>
        <p>
            @Html.ActionLink("Add New Product", "Create", null, new { @class = "btn btn-primary" })
        </p>
    </div>
}

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Delete Product</h4>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="productName"></strong>?</p>
                <p class="text-danger">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                @using (Html.BeginForm("Delete", "Products", new { area = "Seller" }, FormMethod.Post, new { id = "deleteForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteProductId" />
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('.btn-delete').click(function (e) {
                e.stopPropagation(); // Prevent row click navigation
                var id = $(this).data('id');
                var name = $(this).data('name');
                $('#deleteProductId').val(id);
                $('#productName').text(name);
                $('#deleteModal').modal('show');
            });
        });
    </script>
}
