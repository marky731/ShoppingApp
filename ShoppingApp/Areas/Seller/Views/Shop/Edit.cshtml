@model ShoppingApp.Models.ViewModels.EditShopViewModel
@{
    ViewBag.Title = "Shop Settings";
}

<h1 class="page-header">Shop Settings</h1>

@using (Html.BeginForm("Edit", "Shop", new { area = "Seller" }, FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ShopId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">Shop Information</h4>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        @Html.LabelFor(m => m.ShopName, new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.TextBoxFor(m => m.ShopName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.ShopName, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Description, new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">Shop Logo</h4>
                </div>
                <div class="panel-body text-center">
                    @if (!string.IsNullOrEmpty(Model.LogoImageUrl))
                    {
                        <img src="@Model.LogoImageUrl" alt="Shop Logo" class="img-responsive img-thumbnail" style="max-width: 200px; margin: 0 auto 15px;" />
                    }
                    else
                    {
                        <span class="glyphicon glyphicon-shopping-bag" style="font-size: 80px; color: #ccc;"></span>
                    }
                    <div class="form-group">
                        @Html.LabelFor(m => m.LogoImageUrl, new { @class = "control-label" })
                        @Html.TextBoxFor(m => m.LogoImageUrl, new { @class = "form-control", placeholder = "Enter logo image URL" })
                        <p class="help-block">Recommended size: 200x200 pixels</p>
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">Banner Image</h4>
                </div>
                <div class="panel-body text-center">
                    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                    {
                        <img src="@Model.BannerImageUrl" alt="Shop Banner" class="img-responsive img-thumbnail" style="max-width: 100%; margin: 0 auto 15px;" />
                    }
                    else
                    {
                        <span class="glyphicon glyphicon-picture" style="font-size: 60px; color: #ccc;"></span>
                    }
                    <div class="form-group">
                        @Html.LabelFor(m => m.BannerImageUrl, new { @class = "control-label" })
                        @Html.TextBoxFor(m => m.BannerImageUrl, new { @class = "form-control", placeholder = "Enter banner image URL" })
                        <p class="help-block">Recommended size: 1200x300 pixels</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
}

@section scripts {
    @Html.Partial("_ValidationScriptsPartial")
}
